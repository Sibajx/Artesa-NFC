#!/bin/sh
# Launcher for the scheduled encrypted backup tool (D10, #126, docs/BACKUP.md).
#
# Installed as <root>/bin/artesa-backup by `artesa-deploy install-tools <id>`
# (#137), next to bin/ops -> ops-<release-id>/ (a read-only copy of that
# verified release's ops/ tool), so it always runs the active tooling's
# artesa_backup.py. Runs with the system Python in isolated mode: no user
# site-packages, no PYTHON* environment variables, no bytecode written.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec /usr/bin/python3 -I -B "$here/ops/artesa_backup.py" "$@"
