# REQUIRED, no default: the app, alembic and the seed refuse to start when it
# is unset. Exactly one of (no aliases such as dev/development/prod):
#   local | test | staging | production
# For normal local development keep `local`. See README "Environment safety".
APP_ENV=local
# Must be false when APP_ENV=production (startup is refused otherwise).
DEBUG=true

POSTGRES_USER=artesanfc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=artesanfc
POSTGRES_HOST=db
POSTGRES_PORT=5432

# REQUIRED, no default: the app, alembic, the seed and pytest refuse to start
# when it is unset, empty or whitespace-only (there is no implicit database;
# docker-compose.yml has no fallback either: the api container reads this file).
# staging/production refuse this development URL and any placeholder password
# (`change-me`, `artesanfc`). Tests must NOT use it: they need a separate
# database whose name has a `test` token, e.g. .../artesanfc_test (README).
DATABASE_URL=postgresql://artesanfc:change-me@db:5432/artesanfc

# Comma-separated exact browser origins allowed to call this API (never "*").
# Default below matches VS Code Live Server, the standard local static
# server for this repo's build-step-free frontend (docs/ARCHITECTURE.md
# section 9). APP_ENV=production refuses to start unless this contains
# https://artesanfc.com, e.g.:
#   CORS_ALLOWED_ORIGINS=https://artesanfc.com
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
