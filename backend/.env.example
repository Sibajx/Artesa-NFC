# REQUIRED, no default: the app, alembic and the seed refuse to start when it
# is unset. Exactly one of (no aliases such as dev/development/prod):
#   local | test | staging | production
# For normal local development keep `local`. See README "Environment safety".
APP_ENV=local
# Must be false when APP_ENV=production (startup is refused otherwise).
DEBUG=true

POSTGRES_USER=artesanfc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=artesanfc
POSTGRES_HOST=db
POSTGRES_PORT=5432

# REQUIRED, no default: the app, alembic, the seed and pytest refuse to start
# when it is unset, empty or whitespace-only (there is no implicit database;
# docker-compose.yml has no fallback either: the api container reads this file).
# staging/production refuse this development URL and any placeholder password
# (`change-me`, `artesanfc`). Tests must NOT use it: they need a separate
# database whose name has a `test` token, e.g. .../artesanfc_test (README).
DATABASE_URL=postgresql://artesanfc:change-me@db:5432/artesanfc

# Comma-separated exact browser origins allowed to call this API (never "*").
# Default below matches VS Code Live Server, the standard local static
# server for this repo's build-step-free frontend (docs/ARCHITECTURE.md
# section 9). APP_ENV=production refuses to start unless this contains
# https://artesanfc.com, e.g.:
#   CORS_ALLOWED_ORIGINS=https://artesanfc.com
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Gestión admin API (docs/DECISIONS.md ADR-029). All three or none; with none,
# /api/admin/* answers 404. Values come from the Cloudflare Access application.
#   ADMIN_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
#   ADMIN_ACCESS_AUD=<64-hex AUD tag of the Access application>
#   ADMIN_EMAILS=person@example.org,other@example.org
#
# ADR-030 roles (optional; each list must be a subset of ADMIN_EMAILS).
# Custodians generate tokens and card keys and write NFC tags; designers
# design certificates. CUSTODY_ACCESS_AUD is the AUD of the separate Access
# application guarding /api/admin/v1/custody, when there is one.
#   CUSTODIAN_EMAILS=person@example.org
#   DESIGNER_EMAILS=
#   CUSTODY_ACCESS_AUD=<64-hex AUD tag of the custody Access application>
#
# P-026: the owner (subset of ADMIN_EMAILS) manages the other accounts from
# Gestión → Usuarios, without editing this file. Optionally, each change is
# mirrored into a Cloudflare Access group that Gestión's policy includes; the
# token needs only "Access: Organizations, Identity Providers, and Groups:
# Edit". Without the three ACCESS_SYNC_* values, the page reminds you to add
# the person in Cloudflare by hand.
#   OWNER_EMAILS=person@example.org
#   ACCESS_SYNC_API_TOKEN=<Cloudflare API token>
#   ACCESS_SYNC_ACCOUNT_ID=<Cloudflare account id>
#   ACCESS_SYNC_GROUP_ID=<Access group id>
#
# Gestión phase 4 media (docs/MEDIA.md): absolute path holding originales/ and
# publico/. Unset: /media/ answers 404 and uploads 503.
#   MEDIA_ROOT=/home/energias/artesa-nfc/media
