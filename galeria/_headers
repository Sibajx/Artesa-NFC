/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-vyD0tDLKSgU2naTnaXTz2+x9ZDwIx28ZDvB62usV+EQ=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://api.artesanfc.com; media-src https://api.artesanfc.com; connect-src 'self' https://api.artesanfc.com https://cloudflareinsights.com; form-action 'self' https://info.artesanfc.com mailto:; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS, JS, fuentes y fotos reducidas llevan huella en la URL (?v= o en el
# nombre): se guardan un año. Las reglas no se pisan entre sí porque Pages
# junta los valores de todas las que coinciden.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fotos/*
  Cache-Control: public, max-age=31536000, immutable

/assets/favicon.svg
  Cache-Control: public, max-age=604800

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400
