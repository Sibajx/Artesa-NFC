{
  "name": "artesanfc-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ArtesaNFC public frontend (Astro). Migration target for frontend/; see web/README.md.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-decoders.mjs",
    "prebuild": "node scripts/copy-decoders.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "measure:assets": "node scripts/measure-assets.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build && npm run measure:assets"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@google/model-viewer": "4.3.1",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
