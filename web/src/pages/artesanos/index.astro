---
// /artesanos — "Las manos": dark hero, then numbered editorial rows.
import "@/styles/islands.css";
import "@/styles/pages.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import NoScript from "@/components/ui/NoScript.astro";
import Greca from "@/components/home/Greca.astro";
import ArtisanList from "@/components/islands/ArtisanList";
---

<BaseLayout
  title="Artesanos"
  description="Artesanas y artesanos de Oaxaca cuyas piezas forman parte de ArtesaNFC."
  canonicalPath="/artesanos/"
  headerTone="dark"
>
  <section class="night-hero on-dark" aria-labelledby="artisans-title" data-header-dark-zone>
    <div class="night-hero__grid" aria-hidden="true"></div>
    <div class="container night-hero__inner rise">
      <p class="hud-label">Autoría · Oaxaca</p>
      <h1 id="artisans-title" class="display-l night-hero__title">
        Artesanos
      </h1>
      <p class="lead">
        Las manos detrás de cada pieza: quién la talló, en qué comunidad y con qué oficio.
      </p>
      <p class="hud-coords" aria-hidden="true">
        17.0732° N · 96.7266° O
      </p>
    </div>
    <Greca />
  </section>

  <section class="section container" aria-label="Lista de artesanos">
    <NoScript>
      La lista de artesanos se carga con JavaScript desde el registro de ArtesaNFC.
    </NoScript>
    <ArtisanList client:only="react" />
  </section>
</BaseLayout>
