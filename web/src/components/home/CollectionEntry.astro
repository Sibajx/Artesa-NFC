---
// Home block 3 — visual entry to the collection. Static on purpose: the home
// shows no API data, so it communicates fully without JavaScript or the API.
//
// 2026-10: the image carries an illustrative holographic certificate card
// (labelled "Ejemplo", never a real piece). With a fine pointer the card tilts
// and its foil follows the cursor; with touch or reduced motion it stays still
// with a static sheen. The card is a real figure with readable text.
import ResponsivePicture from "@/components/ui/ResponsivePicture.astro";
import { collectionEntryImage, homeCopy } from "@/content/site";
const { collection } = homeCopy;
const { certificate } = collection;
---

<section class="collection section on-dark" aria-labelledby="collection-title">
  <div class="container collection__grid">
    <div class="collection__visual">
      <a
        class="collection__media media-frame"
        href={collection.cta.href}
        tabindex="-1"
        aria-hidden="true"
      >
        <ResponsivePicture
          image={collectionEntryImage}
          sizes="(min-width: 900px) 50vw, 100vw"
          decorative
        />
        {collectionEntryImage.provisional && (
          <span class="placeholder-note">Imagen provisional</span>
        )}
      </a>

      <figure class="cert" data-holo aria-label={`${certificate.label} (${certificate.example})`}>
        <div class="cert__card">
          <span class="cert__foil" aria-hidden="true"></span>
          <div class="cert__head">
            <span class="cert__label">{certificate.label}</span>
            <span class="cert__example">{certificate.example}</span>
          </div>
          <p class="cert__title">{certificate.title}</p>
          <dl class="cert__rows">
            {certificate.rows.map((row) => (
              <div>
                <dt>{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
          <div class="cert__foot">
            <span class="cert__serial">{certificate.serial}</span>
            <svg class="cert__nfc" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M7 8a6 6 0 0 1 0 8M11 5a10 10 0 0 1 0 14M15 2a14 14 0 0 1 0 20"></path>
            </svg>
          </div>
        </div>
      </figure>
    </div>

    <div class="collection__text" data-reveal>
      <p class="eyebrow">{collection.eyebrow}</p>
      <h2 id="collection-title" class="display-l">
        {collection.title}
      </h2>
      <p class="lead">{collection.body}</p>
      <div class="collection__links">
        <a class="button button--glow" href={collection.cta.href}>
          {collection.cta.label}
        </a>
        <a class="editorial-link" href={collection.secondary.href}>
          {collection.secondary.label}
        </a>
      </div>
      <!-- Shown only when Gestión has more than one collection (see the script). -->
      <div class="collection__nav" role="group" aria-label="Colecciones" hidden>
        <button
          type="button"
          class="collection__arrow"
          data-dir="-1"
          aria-label="Colección anterior"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 5l-7 7 7 7"></path>
          </svg>
        </button>
        <ul class="collection__dots" role="list"></ul>
        <button
          type="button"
          class="collection__arrow"
          data-dir="1"
          aria-label="Colección siguiente"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
        <button type="button" class="collection__pause" aria-pressed="false">
          Pausar
        </button>
      </div>
      <p class="sr-only" role="status" aria-live="polite" data-collection-status></p>
    </div>
  </div>
</section>

<script>
  // P-029: the photo of this block can be replaced from Gestión. The page ships
  // with its provisional image; when the API has a photo for this slot it is
  // swapped in, and the "Imagen provisional" label goes once it has loaded. Any
  // failure (API down, file missing) leaves the provisional image untouched.
  import { createApiClient } from "@/lib/api";
  import { currentApiConfig, resolveMediaUrl } from "@/lib/api-config";
  import { nextIndex, safeLink } from "@/lib/collections";
  import type { CollectionPublic } from "@/lib/types";

  async function replaceCollectionImage(): Promise<void> {
    const picture = document.querySelector<HTMLPictureElement>(".collection__media picture");
    const img = picture?.querySelector("img");
    if (!picture || !img) return;
    const config = currentApiConfig();
    const result = await createApiClient({ config, timeoutMs: 2500 }).getSiteImages();
    if (result.kind !== "ok") return;
    const files = result.data.data["collection-entry"];
    if (!files) return;
    const jpg = resolveMediaUrl(files.jpg, config);
    const webp = resolveMediaUrl(files.webp, config);
    const avif = resolveMediaUrl(files.avif, config);
    if (!jpg) return;
    // The current image stays on screen until the new one has loaded.
    img.addEventListener(
      "load",
      () => document.querySelector(".collection__media .placeholder-note")?.remove(),
      { once: true },
    );
    picture.querySelectorAll("source").forEach((source) => source.remove());
    for (const [type, url] of [
      ["image/avif", avif],
      ["image/webp", webp],
    ] as const) {
      if (!url) continue;
      const source = document.createElement("source");
      source.type = type;
      source.srcset = url;
      picture.insertBefore(source, img);
    }
    img.width = files.width;
    img.height = files.height;
    img.src = jpg;
  }

  // Gestión → Hero → Colecciones: when there are entries, they replace the built-in photo,
  // title, text and button. With one, it is fixed; with more, the block rotates between them
  // (arrows, dots and a pause button; it stops with reduced motion and while the pointer or
  // the keyboard is on it). Any failure leaves the page as it shipped.
  const DEFAULT_LINK = "/piezas/";
  const AUTOPLAY_MS = 7000;
  const FADE_MS = 240;

  function startCarousel(
    entries: readonly CollectionPublic[],
    config: ReturnType<typeof currentApiConfig>,
  ): void {
    const root = document.querySelector<HTMLElement>(".collection");
    const picture = root?.querySelector<HTMLPictureElement>(".collection__media picture");
    const img = picture?.querySelector("img");
    const mediaLink = root?.querySelector<HTMLAnchorElement>(".collection__media");
    const title = root?.querySelector<HTMLElement>("#collection-title");
    const lead = root?.querySelector<HTMLElement>(".collection__text .lead");
    const cta = root?.querySelector<HTMLAnchorElement>(".collection__links .button");
    const nav = root?.querySelector<HTMLElement>(".collection__nav");
    const dotsList = root?.querySelector<HTMLElement>(".collection__dots");
    const pauseButton = root?.querySelector<HTMLButtonElement>(".collection__pause");
    const status = root?.querySelector<HTMLElement>("[data-collection-status]");
    if (
      !root ||
      !picture ||
      !img ||
      !mediaLink ||
      !title ||
      !lead ||
      !cta ||
      !nav ||
      !dotsList ||
      !pauseButton ||
      !status
    )
      return;

    const slides = entries
      .map((e) => ({
        title: e.title,
        body: e.body,
        cta: e.cta_label,
        href: safeLink(e.link, DEFAULT_LINK),
        avif: resolveMediaUrl(e.image.avif, config),
        webp: resolveMediaUrl(e.image.webp, config),
        jpg: resolveMediaUrl(e.image.jpg, config),
        width: e.image.width,
        height: e.image.height,
      }))
      .filter((s) => s.jpg);
    if (slides.length === 0) return;

    const defaultLead = lead.textContent ?? "";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = -1;
    let timer = 0;
    let paused = reduced; // reduced motion: never rotates by itself
    let hovering = false;
    let focused = false; // keyboard focus inside the block (a mouse click does not count)
    let swapping = false;

    const apply = (index: number): void => {
      const slide = slides[index];
      if (!slide) return;
      current = index;
      picture.querySelectorAll("source").forEach((source) => source.remove());
      for (const [type, url] of [
        ["image/avif", slide.avif],
        ["image/webp", slide.webp],
      ] as const) {
        if (!url) continue;
        const source = document.createElement("source");
        source.type = type;
        source.srcset = url;
        picture.insertBefore(source, img);
      }
      img.width = slide.width;
      img.height = slide.height;
      img.src = slide.jpg ?? "";
      root.querySelector(".collection__media .placeholder-note")?.remove();
      title.textContent = slide.title;
      lead.textContent = slide.body ?? defaultLead;
      cta.textContent = slide.cta;
      cta.href = slide.href;
      mediaLink.href = slide.href;
      dotsList.querySelectorAll("button").forEach((dot, i) => {
        if (i === index) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      // Warm the next photo so the change does not wait on the network.
      const next = slides[nextIndex(index, 1, slides.length)];
      if (next?.jpg && slides.length > 1) new Image().src = next.jpg;
    };

    const go = (dir: number, announce: boolean): void => {
      if (swapping || slides.length < 2) return;
      const target = nextIndex(current, dir, slides.length);
      const finish = () => {
        apply(target);
        if (announce)
          status.textContent = `Colección ${target + 1} de ${slides.length}: ${slides[target]?.title ?? ""}`;
        root.classList.remove("is-fading");
        swapping = false;
      };
      if (reduced) {
        finish();
        return;
      }
      swapping = true;
      root.classList.add("is-fading");
      window.setTimeout(finish, FADE_MS);
    };

    const schedule = (): void => {
      window.clearInterval(timer);
      if (slides.length < 2 || paused || hovering || focused || document.hidden) return;
      timer = window.setInterval(() => go(1, false), AUTOPLAY_MS);
    };

    apply(0);
    if (slides.length < 2) return;

    nav.hidden = false;
    slides.forEach((slide, i) => {
      const item = document.createElement("li");
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className = "collection__dot";
      dot.setAttribute("aria-label", `Ver la colección ${i + 1}: ${slide.title}`);
      if (i === 0) dot.setAttribute("aria-current", "true");
      dot.addEventListener("click", () => {
        if (i !== current) go(i - current, true);
        schedule();
      });
      item.append(dot);
      dotsList.append(item);
    });
    nav.querySelectorAll<HTMLButtonElement>(".collection__arrow").forEach((button) =>
      button.addEventListener("click", () => {
        go(Number(button.dataset.dir), true);
        schedule();
      }),
    );
    pauseButton.textContent = reduced ? "Reproducir" : "Pausar";
    pauseButton.setAttribute("aria-pressed", String(reduced));
    pauseButton.addEventListener("click", () => {
      paused = !paused;
      pauseButton.textContent = paused ? "Reproducir" : "Pausar";
      pauseButton.setAttribute("aria-pressed", String(paused));
      schedule();
    });
    root.addEventListener("pointerenter", () => {
      hovering = true;
      schedule();
    });
    root.addEventListener("pointerleave", () => {
      hovering = false;
      schedule();
    });
    root.addEventListener("focusin", (event) => {
      focused = event.target instanceof Element && event.target.matches(":focus-visible");
      schedule();
    });
    root.addEventListener("focusout", () => {
      focused = false;
      schedule();
    });
    document.addEventListener("visibilitychange", schedule);
    schedule();
  }

  async function initCollection(): Promise<void> {
    const config = currentApiConfig();
    const result = await createApiClient({ config, timeoutMs: 2500 }).getCollections();
    if (result.kind === "ok" && result.data.data.length > 0) {
      startCarousel(result.data.data, config);
      return;
    }
    await replaceCollectionImage();
  }
  void initCollection().catch(() => undefined);

  // Pointer-driven tilt + foil position, written as CSS custom properties
  // (CSSOM, allowed by the CSP). Only for a fine pointer and allowed motion.
  const card = document.querySelector<HTMLElement>("[data-holo]");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (card && fine && !reduced) {
    const area = card.closest<HTMLElement>(".collection__visual") ?? card;
    let frame = 0;
    area.addEventListener("pointermove", (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = card.getBoundingClientRect();
        const x = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1);
        const y = Math.min(Math.max((e.clientY - r.top) / r.height, 0), 1);
        card.style.setProperty("--mx", `${(x * 100).toFixed(1)}%`);
        card.style.setProperty("--my", `${(y * 100).toFixed(1)}%`);
        card.style.setProperty("--ry", `${((x - 0.5) * 16).toFixed(2)}deg`);
        card.style.setProperty("--rx", `${((0.5 - y) * 12).toFixed(2)}deg`);
        card.classList.add("is-active");
      });
    });
    area.addEventListener("pointerleave", () => {
      cancelAnimationFrame(frame);
      card.classList.remove("is-active");
      for (const p of ["--mx", "--my", "--rx", "--ry"]) card.style.removeProperty(p);
    });
  }
</script>

<style>
  .collection {
    background:
      radial-gradient(
        ellipse at 15% 80%,
        color-mix(in srgb, var(--color-grana) 14%, transparent),
        transparent 50%
      ),
      var(--color-night);
    color: var(--color-text-inverse);
  }

  .collection__grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .collection__visual {
    position: relative;
    padding-bottom: var(--space-lg);
  }

  .collection__media {
    aspect-ratio: 4 / 5;
    display: block;
    background: var(--color-wood);
    width: 85%;
  }

  /* The certificate card sits over the bottom of the image. */
  .collection__media :global(.placeholder-note) {
    top: var(--space-xs);
    bottom: auto;
  }

  .collection__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Holographic certificate card ------------------------------------- */

  .cert {
    --mx: 30%;
    --my: 20%;
    --rx: 4deg;
    --ry: -8deg;
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(320px, 72%);
    margin: 0;
    perspective: 900px;
  }

  .cert__card {
    position: relative;
    display: grid;
    gap: var(--space-sm);
    padding: 22px;
    border-radius: 14px;
    overflow: hidden;
    color: var(--color-text-inverse);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-night-raised) 92%, transparent),
      color-mix(in srgb, var(--color-night) 96%, transparent)
    );
    border: 1px solid color-mix(in srgb, var(--color-cempasuchil) 45%, transparent);
    box-shadow:
      0 30px 60px -20px rgb(0 0 0 / 0.7),
      0 0 30px -8px color-mix(in srgb, var(--color-cempasuchil) 40%, transparent);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform var(--duration-editorial) var(--ease-out);
    backdrop-filter: blur(8px);
  }

  .cert:global(.is-active) .cert__card {
    transition-duration: 120ms;
  }

  /* Foil in dye colours: cempasúchil, grana, añil. */
  .cert__foil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at var(--mx) var(--my), rgb(255 255 255 / 0.22), transparent 40%),
      linear-gradient(
        115deg,
        transparent 20%,
        color-mix(in srgb, var(--color-cempasuchil) 35%, transparent) 38%,
        color-mix(in srgb, var(--color-grana) 30%, transparent) 50%,
        color-mix(in srgb, var(--color-anil) 35%, transparent) 62%,
        transparent 80%
      );
    background-size:
      100% 100%,
      240% 240%;
    background-position:
      0 0,
      var(--mx) var(--my);
    mix-blend-mode: screen;
    opacity: 0.55;
  }

  .cert__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xs);
  }

  .cert__label,
  .cert__example,
  .cert__serial {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cert__label {
    color: var(--color-cempasuchil);
  }

  .cert__example {
    padding: 0.2em 0.5em;
    border: 1px dashed currentColor;
    border-radius: 2px;
    color: color-mix(in srgb, var(--color-text-inverse) 80%, transparent);
  }

  .cert__title {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
  }

  .cert__rows {
    display: grid;
    gap: 6px;
  }

  .cert__rows div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-rule-dark);
    font-size: var(--text-small);
  }

  .cert__rows dt {
    color: color-mix(in srgb, var(--color-text-inverse) 72%, transparent);
  }

  .cert__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: color-mix(in srgb, var(--color-text-inverse) 72%, transparent);
  }

  .cert__nfc {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--color-cempasuchil);
    stroke-width: 1.6;
    stroke-linecap: round;
    filter: drop-shadow(0 0 4px var(--color-cempasuchil));
  }

  /* --- Text column -------------------------------------------------------- */

  .collection__text {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  .collection__text .lead {
    color: color-mix(in srgb, var(--color-text-inverse) 85%, transparent);
  }

  .collection__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-xs);
  }

  /* --- Carousel (only when there is more than one collection) ------------- */

  .collection__visual,
  .collection__text {
    transition: opacity 240ms var(--ease-out);
  }

  .collection:global(.is-fading) .collection__visual,
  .collection:global(.is-fading) .collection__text {
    opacity: 0;
  }

  .collection__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .collection__nav[hidden] {
    display: none;
  }

  .collection__arrow {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid color-mix(in srgb, var(--color-cempasuchil) 55%, transparent);
    border-radius: 50%;
    background: transparent;
    color: var(--color-cempasuchil);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .collection__arrow:hover {
    background: color-mix(in srgb, var(--color-cempasuchil) 18%, transparent);
  }

  .collection__arrow:active {
    transform: scale(0.94);
  }

  .collection__arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .collection__dots {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection__dots :global(.collection__dot) {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  .collection__dots :global(.collection__dot)::after {
    content: "";
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-text-inverse) 40%, transparent);
    transition:
      background-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .collection__dots :global(.collection__dot[aria-current="true"])::after {
    background: var(--color-cempasuchil);
    transform: scale(1.35);
  }

  .collection__pause {
    min-height: 44px;
    padding: 0 var(--space-xs);
    border: 0;
    background: transparent;
    color: color-mix(in srgb, var(--color-text-inverse) 78%, transparent);
    font: inherit;
    font-size: var(--text-small);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .cert__card {
      transform: none;
    }

    .collection__visual,
    .collection__text,
    .collection__arrow,
    .collection__dots :global(.collection__dot)::after {
      transition: none;
    }
  }

  @media (min-width: 900px) {
    .collection__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
