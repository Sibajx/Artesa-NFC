---
// Home block 1 — video hero (DESIGN_SYSTEM.md §7, ADR-014).
// The poster <picture> is the real content layer: the heading and message are
// plain HTML over it and work with no JavaScript, no video, reduced motion or
// Save-Data. The video is an enhancement added by the script below, never
// the only carrier of information (it is aria-hidden and has no audio).
//
// 2026-10 visible-technology layer (culture first): a canvas "field of
// threads", a scan sweep, a rotating seal (Origen · Oficio · Autoría) around
// an NFC wave, and the greca band. All decorative and aria-hidden; the title,
// message and CTA stay plain HTML that works without JS or motion.
import ResponsivePicture from "@/components/ui/ResponsivePicture.astro";
import Greca from "@/components/home/Greca.astro";
import { heroMedia, homeCopy } from "@/content/site";

const { hero } = homeCopy;
const titleWords = hero.title.split(" ");
const sealText = "ORIGEN · OFICIO · AUTORÍA · PIEZA ÚNICA · ";
const sealLength = (2 * Math.PI * 78).toFixed(1);
const sources = JSON.stringify({
  desktop: heroMedia.desktopVideo,
  mobile: heroMedia.mobileVideo.length > 0 ? heroMedia.mobileVideo : heroMedia.desktopVideo,
});
const hasVideo = heroMedia.desktopVideo.length > 0;
---

<section class="hero on-dark" aria-labelledby="hero-title" data-header-dark-zone>
  <div class="hero__media">
    <ResponsivePicture
      image={heroMedia.poster}
      class="hero__poster"
      loading="eager"
      fetchpriority="high"
      decorative
    />
    {hasVideo && (
      <video
        class="hero__video"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        aria-hidden="true"
        tabindex="-1"
        data-hero-video
        data-sources={sources}
      />
    )}
    <div class="hero__scrim"></div>
    <canvas class="hero__field" aria-hidden="true" data-hero-field></canvas>
    <div class="hero__scan" aria-hidden="true"></div>
  </div>

  <div class="hero__seal" aria-hidden="true">
    <svg viewBox="0 0 200 200" focusable="false">
      <defs>
        <path id="hero-seal-circle" d="M100 100m-78 0a78 78 0 1 1 156 0a78 78 0 1 1-156 0"></path>
      </defs>
      <circle class="hero__seal-ring" cx="100" cy="100" r="92"></circle>
      <circle class="hero__seal-ring hero__seal-ring--dash" cx="100" cy="100" r="64"></circle>
      <g class="hero__seal-text">
        <text>
          <textPath href="#hero-seal-circle" textLength={sealLength} lengthAdjust="spacing">
            {sealText}
          </textPath>
        </text>
      </g>
      <g class="hero__seal-waves">
        <path d="M92 86a20 20 0 0 1 0 28"></path>
        <path d="M101 78a32 32 0 0 1 0 44"></path>
        <path d="M110 70a44 44 0 0 1 0 60"></path>
      </g>
      <circle class="hero__seal-core" cx="84" cy="100" r="4"></circle>
    </svg>
  </div>

  <div class="hero__content container">
    <p class="hud-label">{hero.eyebrow}</p>
    <h1 id="hero-title" class="hero__title display-xl">
      {titleWords.map((word, i) => (
        <>
          <span class="hero__word">{word}</span>
          {i < titleWords.length - 1 && " "}
        </>
      ))}
    </h1>
    <p class="hero__subtitle lead">{hero.subtitle}</p>
    <a class="button button--glow" href={hero.cta.href}>
      {hero.cta.label}
    </a>
  </div>

  <div class="hero__meta container">
    {heroMedia.provisional && (
      <p class="placeholder-note" data-provisional="hero">
        Imagen y video provisionales
      </p>
    )}
    {hasVideo && (
      <button type="button" class="hero__toggle" data-hero-toggle hidden aria-pressed="false">
        Pausar video
      </button>
    )}
  </div>
  <Greca class="hero__greca" />
</section>

<script>
  // Plays the hero video only when motion and data use are acceptable:
  // never with prefers-reduced-motion, Save-Data, or a 2G-class connection.
  // Sources are attached here (preload="none" + no <source> in the HTML), so
  // a visitor who does not get the video downloads none of it.
  import { startHeroField } from "@/scripts/hero-field";
  import { createApiClient } from "@/lib/api";
  import { currentApiConfig, resolveMediaUrl } from "@/lib/api-config";

  interface NetworkInformationLike {
    saveData?: boolean;
    effectiveType?: string;
  }

  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-hero-toggle]");

  function motionAllowed(): boolean {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return false;
    const connection = (navigator as Navigator & { connection?: NetworkInformationLike })
      .connection;
    if (connection?.saveData) return false;
    if (connection?.effectiveType && /(^|-)2g$/.test(connection.effectiveType)) return false;
    return true;
  }

  function setToggle(playing: boolean): void {
    if (!toggle) return;
    toggle.hidden = false;
    toggle.setAttribute("aria-pressed", String(!playing));
    toggle.textContent = playing ? "Pausar video" : "Reproducir video";
  }

  const field = document.querySelector<HTMLCanvasElement>("[data-hero-field]");
  if (field) startHeroField(field);

  type VideoSource = { src: string; type: string };

  // P-028: the season's video and poster, when Gestión has one for today.
  // Asked only when the video would play (no extra request for visitors on
  // reduced motion or Save-Data); any failure keeps the built-in hero.
  async function seasonalHero(): Promise<{ sources: VideoSource[]; poster: string } | null> {
    const config = currentApiConfig();
    const result = await createApiClient({ config, timeoutMs: 2500 }).getHero();
    if (result.kind !== "ok" || result.data.data === null) return null;
    const { video, poster } = result.data.data;
    const mp4 = resolveMediaUrl(video.mp4, config);
    const webm = video.webm ? resolveMediaUrl(video.webm, config) : null;
    const posterUrl = resolveMediaUrl(poster, config);
    if (!mp4 || !posterUrl) return null;
    const sources: VideoSource[] = [];
    if (webm) sources.push({ src: webm, type: "video/webm" });
    sources.push({ src: mp4, type: "video/mp4" });
    return { sources, poster: posterUrl };
  }

  function showSeasonalPoster(url: string): void {
    const picture = document.querySelector(".hero__poster");
    const img = picture?.querySelector("img");
    if (!picture || !img) return;
    picture.querySelectorAll("source").forEach((s) => s.remove());
    img.removeAttribute("srcset");
    img.src = url;
    document.querySelector('[data-provisional="hero"]')?.remove();
  }

  async function startVideo(el: HTMLVideoElement): Promise<void> {
    const sources = JSON.parse(el.dataset.sources ?? "{}") as Record<
      "desktop" | "mobile",
      VideoSource[]
    >;
    const portrait = window.matchMedia("(max-width: 700px) and (orientation: portrait)").matches;
    let chosen = (portrait ? sources.mobile : sources.desktop) ?? [];
    const season = await seasonalHero().catch(() => null);
    if (season) {
      chosen = season.sources;
      showSeasonalPoster(season.poster);
    }
    const playable = chosen.filter((s) => el.canPlayType(s.type) !== "");

    if (playable.length > 0) {
      for (const source of playable) {
        const node = document.createElement("source");
        node.src = source.src;
        node.type = source.type;
        el.appendChild(node);
      }
      let userPaused = false;
      el.addEventListener("playing", () => {
        el.classList.add("is-playing");
        setToggle(true);
      });
      el.addEventListener("pause", () => setToggle(false));
      // Any decoding/network failure leaves the poster in place.
      el.addEventListener("error", () => el.remove(), true);

      toggle?.addEventListener("click", () => {
        if (el.paused) {
          userPaused = false;
          void el.play();
        } else {
          userPaused = true;
          el.pause();
        }
      });

      // Play only while visible; never resume a video the visitor paused.
      const observer = new IntersectionObserver(([entry]) => {
        if (entry?.isIntersecting && !userPaused) {
          el.play().catch(() => setToggle(false));
        } else if (!entry?.isIntersecting && !el.paused) {
          el.pause();
        }
      });
      observer.observe(el);
    }
  }

  if (video && motionAllowed()) void startVideo(video);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto auto;
    color: var(--color-text-inverse);
    background: var(--color-night);
    overflow: hidden;
  }

  .hero__media,
  .hero__media :global(.hero__poster),
  .hero__video,
  .hero__scrim,
  .hero__field,
  .hero__scan {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(.hero__poster img),
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    opacity: 0;
    transition: opacity var(--duration-scene) var(--ease-out);
  }

  .hero__video:global(.is-playing) {
    opacity: 1;
  }

  .hero__scrim {
    background:
      radial-gradient(
        ellipse at 78% 40%,
        color-mix(in srgb, var(--color-cempasuchil) 14%, transparent),
        transparent 55%
      ),
      linear-gradient(
        to top,
        rgb(13 11 10 / 0.9) 0%,
        rgb(13 11 10 / 0.3) 55%,
        rgb(13 11 10 / 0.5) 100%
      ),
      linear-gradient(to right, rgb(13 11 10 / 0.55), transparent 70%);
  }

  .hero__field {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-scene) var(--ease-out);
  }

  .hero__field:global(.is-live) {
    opacity: 1;
  }

  /* One scan sweep on arrival, then a slow repeat: light reading the piece. */
  .hero__scan {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--color-cempasuchil) 22%, transparent) 49.5%,
      color-mix(in srgb, var(--color-cempasuchil) 70%, transparent) 50%,
      transparent 50.5%
    );
    background-size: 100% 260%;
    background-repeat: no-repeat;
    mix-blend-mode: screen;
    opacity: 0.55;
    animation: hero-scan 9s var(--ease-out) 0.4s infinite;
    background-position: 0 130%;
  }

  @keyframes hero-scan {
    0% {
      background-position: 0 130%;
    }
    28%,
    100% {
      background-position: 0 -30%;
    }
  }

  .hero__seal {
    position: absolute;
    right: clamp(16px, 7vw, 120px);
    top: 50%;
    width: clamp(180px, 26vw, 360px);
    aspect-ratio: 1;
    translate: 0 -50%;
    pointer-events: none;
    display: none;
  }

  .hero__seal svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hero__seal-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--color-cempasuchil) 45%, transparent);
    stroke-width: 0.75;
  }

  .hero__seal-ring--dash {
    stroke-dasharray: 2 6;
    transform-origin: 100px 100px;
    animation: hero-spin 40s linear infinite reverse;
  }

  .hero__seal-text {
    transform-origin: 100px 100px;
    animation: hero-spin 60s linear infinite;
  }

  .hero__seal-text text {
    font-family: var(--font-mono);
    font-size: 7.2px;
    letter-spacing: 0.32em;
    fill: color-mix(in srgb, var(--color-text-inverse) 75%, transparent);
  }

  .hero__seal-waves path {
    fill: none;
    stroke: var(--color-cempasuchil);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.2;
    filter: drop-shadow(0 0 4px var(--color-cempasuchil));
    animation: hero-wave 2.4s ease-out infinite;
  }

  .hero__seal-waves path:nth-child(2) {
    animation-delay: 0.3s;
  }

  .hero__seal-waves path:nth-child(3) {
    animation-delay: 0.6s;
  }

  .hero__seal-core {
    fill: var(--color-cempasuchil);
    filter: drop-shadow(0 0 6px var(--color-cempasuchil));
  }

  @keyframes hero-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes hero-wave {
    0%,
    100% {
      opacity: 0.15;
    }
    35% {
      opacity: 1;
    }
  }

  @media (min-width: 900px) {
    .hero__seal {
      display: block;
    }
  }

  /* Title enters word by word (CSS only; reduced motion shows it at once). */
  .hero__word {
    display: inline-block;
    animation: hero-word var(--duration-editorial) var(--ease-out) both;
  }

  .hero__word:nth-child(2) {
    animation-delay: 90ms;
  }
  .hero__word:nth-child(3) {
    animation-delay: 180ms;
  }
  .hero__word:nth-child(4) {
    animation-delay: 270ms;
  }
  .hero__word:nth-child(5) {
    animation-delay: 360ms;
  }
  .hero__word:nth-child(6) {
    animation-delay: 450ms;
  }

  @keyframes hero-word {
    from {
      opacity: 0;
      transform: translateY(0.35em);
      filter: blur(6px);
    }
  }

  .hero :global(.hero__greca) {
    position: relative;
  }

  .hero__content {
    position: relative;
    align-self: end;
    display: grid;
    justify-items: start;
    gap: var(--space-sm);
    padding-top: 120px;
    padding-bottom: var(--space-md);
  }

  .hero__title {
    max-width: 14ch;
  }

  .hero__subtitle {
    color: color-mix(in srgb, var(--color-text-inverse) 88%, transparent);
    margin-bottom: var(--space-xs);
  }

  .hero__meta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    padding-bottom: var(--space-md);
  }

  .hero__meta .placeholder-note {
    background: rgb(0 0 0 / 0.35);
    color: var(--color-text-inverse);
  }

  .hero__toggle {
    min-height: var(--touch-target-min);
    padding: 0 1em;
    border: 1px solid color-mix(in srgb, var(--color-text-inverse) 60%, transparent);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.3);
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
  }
</style>
