---
// Header — DESIGN_SYSTEM.md §6 (ADR-015/016): visible on entry, hides while
// scrolling down, reappears when scrolling up. Links are plain anchors that
// work without JavaScript; the script only adds the scroll behaviour.
interface Props {
  tone: "light" | "dark";
  minimal: boolean;
}
const { tone, minimal } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/piezas/", label: "Piezas" },
  { href: "/artesanos/", label: "Artesanos" },
  { href: "/nosotros/", label: "Nosotros" },
];
const isCurrent = (href: string) => path.startsWith(href);
// La galería pública vive en artesanfc.com; este sitio (info.) es el panel.
// Quien llega aquí desde una pieza de la galería necesita un camino de vuelta
// que no sea el botón «atrás» del navegador (2026-11-01).
const GALLERY_URL = "https://artesanfc.com/";
---

<header class="site-header" data-tone={tone} data-initial-tone={tone} data-hidden="false">
  <div class="site-header__back">
    <div class="container">
      <a href={GALLERY_URL}>
        <span aria-hidden="true">←</span> Volver a la galería
        <span class="site-header__back-host">artesanfc.com</span>
      </a>
    </div>
  </div>
  <div class="site-header__inner container">
    <a class="site-header__logo" href="/" aria-label="ArtesaNFC, inicio">
      ArtesaNFC
    </a>
    {!minimal && (
      <nav aria-label="Principal">
        <ul class="site-header__nav" role="list">
          {links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-rule);
    transition:
      transform var(--duration-ui) var(--ease-out),
      background-color var(--duration-ui) var(--ease-out),
      color var(--duration-ui) var(--ease-out);
  }

  .site-header[data-tone="dark"] {
    color: var(--color-text-inverse);
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.45), transparent);
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .site-header[data-tone="dark"] :focus-visible {
    outline-color: var(--color-text-inverse);
  }

  .site-header[data-hidden="true"] {
    transform: translateY(-100%);
  }

  .site-header:focus-within {
    transform: none;
  }

  /* Franja de regreso a la galería: siempre barro, sobre portadas claras y
     oscuras, para que se distinga de la barra y se reconozca. */
  .site-header__back {
    background: var(--color-clay);
    color: var(--color-text-inverse);
    font-size: var(--text-small);
  }

  .site-header__back a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 36px;
    color: inherit;
    text-decoration: none;
  }

  .site-header__back a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-header__back a span[aria-hidden] {
    transition: transform var(--duration-ui) var(--ease-out);
  }

  .site-header__back a:hover span[aria-hidden] {
    transform: translateX(-4px);
  }

  .site-header__back-host {
    opacity: 0.6;
  }

  .site-header__back-host::before {
    content: "· ";
  }

  @media (max-width: 420px) {
    .site-header__back-host {
      display: none;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: 64px;
  }

  .site-header__logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-decoration: none;
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
  }

  .site-header__nav {
    display: flex;
    gap: clamp(0.75rem, 3vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min);
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current="page"] {
    text-decoration: underline;
  }
</style>
