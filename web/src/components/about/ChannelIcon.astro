---
// Simple line icons for contact channels (generic glyphs, not brand logos).
import type { ChannelKind } from "@/content/site";
interface Props {
  kind: ChannelKind;
}
const { kind } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {kind === "email" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="M3 7l9 6 9-6"></path>
    </>
  )}
  {kind === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.5" cy="6.5" r="0.6"></circle>
    </>
  )}
  {kind === "facebook" && <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"></path>}
  {kind === "whatsapp" && (
    <>
      <path d="M4 20l1.4-4.2A8 8 0 1 1 8.4 18.8z"></path>
      <path d="M9 9.5c.5 2.4 2.1 4 4.5 4.5l1-1.2 1.8.7-.3 1.6c-3.7.2-7-3.1-6.8-6.8l1.6-.3.7 1.8z"></path>
    </>
  )}
  {kind === "tiktok" && (
    <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.3 5 4.5"></path>
  )}
  {kind === "linkedin" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
      <path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"></path>
    </>
  )}
  {kind === "github" && (
    <path d="M9 19c-4 1.3-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.8 2.8 5.8 3.1 5.8 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path>
  )}
  {kind === "web" && (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
    </>
  )}
</svg>
